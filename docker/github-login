#!/bin/sh
# Log in to GitHub in the browser, once, and give git the attendee's name and
# an address of GitHub's, unless git has them already.
gh auth status >/dev/null 2>&1 || gh auth login --hostname github.com --git-protocol https --web || exit 1
gh auth setup-git
if [ -z "$(git config --global user.name)" ]; then
    git config --global user.name "$(gh api user --jq '.name // .login')"
    git config --global user.email "$(gh api user --jq '"\(.id)+\(.login)@users.noreply.github.com"')"
fi
